<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.framehome" android:versionCode="1" android:versionName="1.0">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="Frame Home" android:icon="@drawable/banner" android:banner="@drawable/banner"
        android:theme="@style/Home" android:allowBackup="false">
        <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask"
            android:stateNotNeeded="true" android:clearTaskOnLaunch="true" android:excludeFromRecents="true"
            android:resumeWhilePausing="true" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".AllAppsActivity" android:exported="false" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
    </application>
</manifest>
